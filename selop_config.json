  "grad_clip": 1.0,
  "init_from": "weights/selop/best.pt",

  "num_workers": 8,
  "amp_dtype": "bf16",
  "omp_threads": 8,
  "seed": 42,

  "eval_every_steps": 5000,
  "log_every_steps": 1,
  "real_recall_target": 0.95,
  "select_metric": "bin_auc",

  "out_dir": "runs/selop_default"
